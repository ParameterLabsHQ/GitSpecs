{
  "name": "git-platform",
  "displayName": "Git Platform",
  "description": "Open-source worktree and branch management for VS Code and Cursor (GitLens-style shell)",
  "version": "0.1.0",
  "publisher": "gitplatform",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbone/gitlens-clone.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onView:gitPlatform.worktrees",
    "onView:gitPlatform.branches",
    "onView:gitPlatform.scm.worktrees",
    "onView:gitPlatform.scm.branches",
    "onCommand:gitPlatform.switchRepository",
    "onCommand:gitPlatform.worktrees.refresh",
    "onCommand:gitPlatform.branches.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitPlatform",
          "title": "Git Platform",
          "icon": "media/git-platform.svg"
        }
      ]
    },
    "views": {
      "gitPlatform": [
        {
          "id": "gitPlatform.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "gitPlatform.branches",
          "name": "Branches"
        }
      ],
      "scm": [
        {
          "id": "gitPlatform.scm.worktrees",
          "name": "Worktrees",
          "contextualTitle": "Git Platform: Worktrees",
          "visibility": "visible"
        },
        {
          "id": "gitPlatform.scm.branches",
          "name": "Branches",
          "contextualTitle": "Git Platform: Branches",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitPlatform.scm.worktrees",
        "contents": "No Git repository open.\n[Open Folder](command:vscode.openFolder)\n\nOr open the full [Git Platform](command:workbench.view.extension.gitPlatform) sidebar."
      },
      {
        "view": "gitPlatform.scm.branches",
        "contents": "No Git repository open.\n[Open Folder](command:vscode.openFolder)\n\nOr open the full [Git Platform](command:workbench.view.extension.gitPlatform) sidebar."
      }
    ],
    "commands": [
      {
        "command": "gitPlatform.switchRepository",
        "title": "Git Platform: Switch Repository…"
      },
      {
        "command": "gitPlatform.worktrees.refresh",
        "title": "Git Platform: Refresh Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPlatform.worktrees.create",
        "title": "Git Platform: Create Worktree…",
        "icon": "$(add)"
      },
      {
        "command": "gitPlatform.worktrees.openCurrentWindow",
        "title": "Git Platform: Open Worktree in Current Window"
      },
      {
        "command": "gitPlatform.worktrees.openNewWindow",
        "title": "Git Platform: Open Worktree in New Window"
      },
      {
        "command": "gitPlatform.worktrees.reveal",
        "title": "Git Platform: Reveal Worktree in File Explorer"
      },
      {
        "command": "gitPlatform.worktrees.copyPath",
        "title": "Git Platform: Copy Worktree Path"
      },
      {
        "command": "gitPlatform.worktrees.remove",
        "title": "Git Platform: Remove Worktree…"
      },
      {
        "command": "gitPlatform.worktrees.prune",
        "title": "Git Platform: Prune Worktrees"
      },
      {
        "command": "gitPlatform.branches.refresh",
        "title": "Git Platform: Refresh Branches",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPlatform.branches.create",
        "title": "Git Platform: Create Branch…",
        "icon": "$(add)"
      },
      {
        "command": "gitPlatform.branches.rename",
        "title": "Git Platform: Rename Branch…"
      },
      {
        "command": "gitPlatform.branches.delete",
        "title": "Git Platform: Delete Branch…"
      },
      {
        "command": "gitPlatform.branches.deleteForce",
        "title": "Git Platform: Delete Branch (Force)…"
      },
      {
        "command": "gitPlatform.branches.checkout",
        "title": "Git Platform: Checkout Branch"
      },
      {
        "command": "gitPlatform.branches.publish",
        "title": "Git Platform: Publish Branch…"
      },
      {
        "command": "gitPlatform.branches.push",
        "title": "Git Platform: Push"
      },
      {
        "command": "gitPlatform.branches.pull",
        "title": "Git Platform: Pull"
      },
      {
        "command": "gitPlatform.branches.fetch",
        "title": "Git Platform: Fetch"
      },
      {
        "command": "gitPlatform.branches.setUpstream",
        "title": "Git Platform: Set Upstream…"
      },
      {
        "command": "gitPlatform.branches.deleteRemote",
        "title": "Git Platform: Delete Remote Branch…"
      },
      {
        "command": "gitPlatform.branches.merge",
        "title": "Git Platform: Merge into Current…"
      },
      {
        "command": "gitPlatform.branches.rebase",
        "title": "Git Platform: Rebase Current Onto…"
      },
      {
        "command": "gitPlatform.branches.cherryPick",
        "title": "Git Platform: Cherry-pick…"
      },
      {
        "command": "gitPlatform.branches.createFromCommit",
        "title": "Git Platform: Create Branch from Commit…"
      },
      {
        "command": "gitPlatform.branches.compare",
        "title": "Git Platform: Compare with…"
      },
      {
        "command": "gitPlatform.branches.copyName",
        "title": "Git Platform: Copy Branch Name"
      },
      {
        "command": "gitPlatform.branches.openRemote",
        "title": "Git Platform: Open on Remote"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitPlatform.worktrees.create",
          "when": "view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees",
          "group": "navigation"
        },
        {
          "command": "gitPlatform.worktrees.refresh",
          "when": "view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees",
          "group": "navigation"
        },
        {
          "command": "gitPlatform.branches.create",
          "when": "view == gitPlatform.branches || view == gitPlatform.scm.branches",
          "group": "navigation"
        },
        {
          "command": "gitPlatform.branches.refresh",
          "when": "view == gitPlatform.branches || view == gitPlatform.scm.branches",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitPlatform.worktrees.openCurrentWindow",
          "when": "(view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitPlatform.worktrees.openNewWindow",
          "when": "(view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitPlatform.worktrees.reveal",
          "when": "(view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitPlatform.worktrees.copyPath",
          "when": "(view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitPlatform.worktrees.remove",
          "when": "(view == gitPlatform.worktrees || view == gitPlatform.scm.worktrees) && viewItem == worktree",
          "group": "3_danger"
        },
        {
          "command": "gitPlatform.branches.checkout",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "1_nav"
        },
        {
          "command": "gitPlatform.branches.copyName",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitPlatform.branches.openRemote",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitPlatform.branches.rename",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem == branchLocal",
          "group": "3_mod"
        },
        {
          "command": "gitPlatform.branches.delete",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitPlatform.branches.deleteForce",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitPlatform.branches.deleteRemote",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem == branchRemote",
          "group": "4_danger"
        },
        {
          "command": "gitPlatform.branches.merge",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitPlatform.branches.rebase",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitPlatform.branches.compare",
          "when": "(view == gitPlatform.branches || view == gitPlatform.scm.branches) && viewItem =~ /branch/",
          "group": "5_hist"
        }
      ],
      "commandPalette": [
        {
          "command": "gitPlatform.worktrees.openCurrentWindow",
          "when": "false"
        },
        {
          "command": "gitPlatform.worktrees.openNewWindow",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git Platform",
      "properties": {
        "gitPlatform.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses PATH."
        },
        "gitPlatform.worktrees.defaultLocation": {
          "type": "string",
          "default": "",
          "description": "Base directory for new worktrees. Empty = parent of the repository root."
        },
        "gitPlatform.worktrees.pathTemplate": {
          "type": "string",
          "default": "${repoName}-${branch}",
          "description": "Leaf folder name template for new worktrees."
        },
        "gitPlatform.worktrees.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Default to opening a newly created worktree in a new window."
        },
        "gitPlatform.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before deleting worktrees or branches."
        },
        "gitPlatform.log.verbosity": {
          "type": "string",
          "enum": ["error", "info", "debug"],
          "default": "info",
          "description": "Output channel verbosity."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "pnpm run build && vsce package --no-dependencies -o git-platform.vsix",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@gitplatform/git-core": "workspace:*",
    "@gitplatform/host-urls": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
