  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitspecs.home",
          "title": "GitSpecs",
          "icon": "media/gitspecs.svg"
        },
        {
          "id": "gitspecs.inspect",
          "title": "GitSpecs Inspect",
          "icon": "media/gitspecs.svg"
        },
        {
          "id": "gitspecs.graph",
          "title": "GitSpecs Graph",
          "icon": "media/gitspecs.svg"
        }
      ]
    },
    "views": {
      "gitspecs.home": [
        {
          "id": "gitspecs.hub",
          "name": "Hub",
          "visibility": "visible"
        }
      ],
      "gitspecs.inspect": [
        {
          "id": "gitspecs.fileHistory",
          "name": "File History",
          "visibility": "visible"
        },
        {
          "id": "gitspecs.lineHistory",
          "name": "Line History",
          "visibility": "collapsed"
        }
      ],
      "gitspecs.graph": [
        {
          "id": "gitspecs.graph",
          "name": "Commit Graph",
          "visibility": "visible"
        }
      ],
      "scm": [
        {
          "id": "gitspecs.scm",
          "name": "GitSpecs",
          "contextualTitle": "GitSpecs",
          "visibility": "visible"
        },
        {
          "id": "gitspecs.worktrees",
          "name": "Worktrees",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.branches",
          "name": "Branches",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.commits",
          "name": "Commits",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.stashes",
          "name": "Stashes",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.tags",
          "name": "Tags",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.remotes",
          "name": "Remotes",
          "visibility": "collapsed"
        },
        {
          "id": "gitspecs.contributors",
          "name": "Contributors",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitspecs.scm",
        "when": "!gitspecs.hasRepository",
        "contents": "No Git repository open.\n[Open Folder](command:vscode.openFolder)\n\nOr open the full [GitSpecs](command:workbench.view.extension.gitspecs) sidebar.\n\nUse the title-bar icons to switch between Worktrees, Branches, Commits, and Stashes."
      },
      {
        "view": "gitspecs.scm",
        "when": "gitspecs.hasRepository && gitspecs.scm.tab == worktrees",
        "contents": "No worktrees to show.\n[Create Worktree](command:gitspecs.worktrees.create)\n[Refresh Worktrees](command:gitspecs.worktrees.refresh)"
      },
      {
        "view": "gitspecs.scm",
        "when": "gitspecs.hasRepository && gitspecs.scm.tab == branches",
        "contents": "No branches to show.\n[Create Branch](command:gitspecs.branches.create)\n[Refresh Branches](command:gitspecs.branches.refresh)"
      },
      {
        "view": "gitspecs.scm",
        "when": "gitspecs.hasRepository && gitspecs.scm.tab == commits",
        "contents": "No commits to show.\n[Refresh Commits](command:gitspecs.commits.refresh)"
      },
      {
        "view": "gitspecs.scm",
        "when": "gitspecs.hasRepository && gitspecs.scm.tab == stashes",
        "contents": "No stashes in this repository.\n[Create Stash](command:gitspecs.stashes.push)\n[Refresh Stashes](command:gitspecs.stashes.refresh)"
      },
      {
        "view": "gitspecs.worktrees",
        "contents": "No Git repository open, or views were moved out of this sidebar.\n[Open Folder](command:vscode.openFolder)\n[Reset View Locations](command:workbench.action.resetViewLocations)\n[Refresh Worktrees](command:gitspecs.worktrees.refresh)"
      },
      {
        "view": "gitspecs.branches",
        "contents": "No branches to show.\n[Open Folder](command:vscode.openFolder)\n[Reset View Locations](command:workbench.action.resetViewLocations)\n[Refresh Branches](command:gitspecs.branches.refresh)"
      },
      {
        "view": "gitspecs.commits",
        "contents": "No commits to show.\n[Open Folder](command:vscode.openFolder)\n[Reset View Locations](command:workbench.action.resetViewLocations)\n[Refresh Commits](command:gitspecs.commits.refresh)"
      },
      {
        "view": "gitspecs.stashes",
        "contents": "No stashes in this repository.\n[Refresh Stashes](command:gitspecs.stashes.refresh)"
      },
      {
        "view": "gitspecs.tags",
        "contents": "No tags in this repository.\n[Refresh Tags](command:gitspecs.tags.refresh)"
      },
      {
        "view": "gitspecs.remotes",
        "contents": "No remotes configured.\n[Refresh Remotes](command:gitspecs.remotes.refresh)"
      },
      {
        "view": "gitspecs.contributors",
        "contents": "No contributors found.\n[Refresh Contributors](command:gitspecs.contributors.refresh)"
      },
      {
        "view": "gitspecs.graph",
        "contents": "No commits to graph.\n[Open Folder](command:vscode.openFolder)\n[Reset View Locations](command:workbench.action.resetViewLocations)\n[Refresh Graph](command:gitspecs.graph.refresh)\n[Open Graph Canvas](command:gitspecs.graph.openView)"
      },
      {
        "view": "gitspecs.hub",
        "contents": "No pull requests or issues to show.\nSign in under Hosting commands, or [Refresh Hub](command:gitspecs.hub.refresh)."
      },
      {
        "view": "gitspecs.fileHistory",
        "contents": "Open a file to show its commit history.\n[File History (QuickPick)](command:gitspecs.history.file)\n[Visual File History](command:gitspecs.history.visualFile)"
      },
      {
        "view": "gitspecs.lineHistory",
        "contents": "Select lines in a file to show line history.\n[Line History (QuickPick)](command:gitspecs.history.line)"
      }
    ],
    "languages": [
      {
        "id": "git-rebase",
        "aliases": [
          "Git Rebase Todo",
          "git-rebase-todo"
        ],
        "filenames": [
          "git-rebase-todo"
        ],
        "configuration": "./media/git-rebase-language-configuration.json"
      }
    ],
