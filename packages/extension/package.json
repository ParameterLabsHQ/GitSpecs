      },
      {
        "command": "gitspecs.branches.createFromCommit",
        "title": "GitSpecs: Create Branch from Commit\u2026"
      },
      {
        "command": "gitspecs.branches.compare",
        "title": "GitSpecs: Compare with\u2026",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitspecs.branches.copyName",
        "title": "GitSpecs: Copy Branch Name"
      },
      {
        "command": "gitspecs.branches.openRemote",
        "title": "GitSpecs: Open on Remote"
      },
      {
        "command": "gitspecs.commits.refresh",
        "title": "GitSpecs: Refresh Commits",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.commits.copySha",
        "title": "GitSpecs: Copy Commit SHA"
      },
      {
        "command": "gitspecs.commits.checkout",
        "title": "GitSpecs: Checkout Commit (Detached)"
      },
      {
        "command": "gitspecs.commits.createBranch",
        "title": "GitSpecs: Create Branch from Commit\u2026"
      },
      {
        "command": "gitspecs.commits.openRemote",
        "title": "GitSpecs: Open Commit on Remote"
      },
      {
        "command": "gitspecs.scm.showStashes",
        "title": "GitSpecs: Show Stashes",
        "icon": "$(archive)",
        "category": "GitSpecs"
      },
      {
        "command": "gitspecs.stashes.refresh",
        "title": "GitSpecs: Refresh Stashes",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.stashes.push",
        "title": "GitSpecs: Stash Changes\u2026",
        "icon": "$(archive)"
      },
      {
        "command": "gitspecs.stashes.apply",
        "title": "GitSpecs: Apply Stash"
      },
      {
        "command": "gitspecs.stashes.pop",
        "title": "GitSpecs: Pop Stash\u2026"
      },
      {
        "command": "gitspecs.stashes.drop",
        "title": "GitSpecs: Drop Stash\u2026"
      },
      {
        "command": "gitspecs.stashes.show",
        "title": "GitSpecs: Show Stash"
      },
      {
        "command": "gitspecs.tags.refresh",
        "title": "GitSpecs: Refresh Tags",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.tags.create",
        "title": "GitSpecs: Create Tag\u2026",
        "icon": "$(add)"
      },
      {
        "command": "gitspecs.tags.delete",
        "title": "GitSpecs: Delete Tag\u2026"
      },
      {
        "command": "gitspecs.tags.copyName",
        "title": "GitSpecs: Copy Tag Name"
      },
      {
        "command": "gitspecs.tags.checkout",
        "title": "GitSpecs: Checkout Tag"
      },
      {
        "command": "gitspecs.remotes.refresh",
        "title": "GitSpecs: Refresh Remotes",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.remotes.fetch",
        "title": "GitSpecs: Fetch Remote"
      },
      {
        "command": "gitspecs.remotes.copyUrl",
        "title": "GitSpecs: Copy Remote URL"
      },
      {
        "command": "gitspecs.remotes.open",
        "title": "GitSpecs: Open Remote in Browser"
      },
      {
        "command": "gitspecs.contributors.refresh",
        "title": "GitSpecs: Refresh Contributors",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.contributors.copyName",
        "title": "GitSpecs: Copy Contributor Name"
      },
      {
        "command": "gitspecs.contributors.copyEmail",
        "title": "GitSpecs: Copy Contributor Email"
      },
      {
        "command": "gitspecs.graph.refresh",
        "title": "GitSpecs: Refresh Commit Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.graph.copySha",
        "title": "GitSpecs: Copy Graph Commit SHA"
      },
      {
        "command": "gitspecs.graph.checkout",
        "title": "GitSpecs: Checkout Graph Commit"
      },
      {
        "command": "gitspecs.graph.createBranch",
        "title": "GitSpecs: Create Branch from Graph Commit\u2026"
      },
      {
        "command": "gitspecs.graph.compare",
        "title": "GitSpecs: Compare Graph Commit\u2026"
      },
      {
        "command": "gitspecs.graph.openRemote",
        "title": "GitSpecs: Open Graph Commit on Remote"
