{
  "name": "gitspecs",
  "displayName": "GitSpecs",
  "description": "Open-source GitLens-style worktrees, branches, commits, blame, history, compare, and search for VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "ParameterLabsHQ",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParameterLabsHQ/GitSpecs.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:gitspecs.worktrees",
    "onView:gitspecs.branches",
    "onView:gitspecs.commits",
    "onView:gitspecs.scm",
    "onCommand:gitspecs.switchRepository",
    "onCommand:gitspecs.scm.showWorktrees",
    "onCommand:gitspecs.scm.showBranches",
    "onCommand:gitspecs.scm.showCommits",
    "onCommand:gitspecs.worktrees.refresh",
    "onCommand:gitspecs.branches.refresh",
    "onCommand:gitspecs.commits.refresh",
    "onCommand:gitspecs.blame.toggleFile",
    "onCommand:gitspecs.blame.showLine",
    "onCommand:gitspecs.blame.fileToOutput",
    "onCommand:gitspecs.blame.statusBarDetails",
    "onCommand:gitspecs.blame.codeLensDetail",
    "onCommand:gitspecs.history.file",
    "onCommand:gitspecs.history.line",
    "onCommand:gitspecs.compare",
    "onCommand:gitspecs.search.commits"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitspecs",
          "title": "GitSpecs",
          "icon": "media/gitspecs.svg"
        }
      ]
    },
    "views": {
      "gitspecs": [
        {
          "id": "gitspecs.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "gitspecs.branches",
          "name": "Branches"
        },
        {
          "id": "gitspecs.commits",
          "name": "Commits"
        }
      ],
      "scm": [
        {
          "id": "gitspecs.scm",
          "name": "GitSpecs",
          "contextualTitle": "GitSpecs",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitspecs.scm",
        "contents": "No Git repository open.\n[Open Folder](command:vscode.openFolder)\n\nOr open the full [GitSpecs](command:workbench.view.extension.gitspecs) sidebar.\n\nUse the title-bar icons to switch between Worktrees, Branches, and Commits."
      }
    ],
    "commands": [
      {
        "command": "gitspecs.switchRepository",
        "title": "GitSpecs: Switch Repository…"
      },
      {
        "command": "gitspecs.scm.showWorktrees",
        "title": "GitSpecs: Show Worktrees",
        "icon": "$(folder)",
        "category": "GitSpecs"
      },
      {
        "command": "gitspecs.scm.showBranches",
        "title": "GitSpecs: Show Branches",
        "icon": "$(git-branch)",
        "category": "GitSpecs"
      },
      {
        "command": "gitspecs.scm.showCommits",
        "title": "GitSpecs: Show Commits",
        "icon": "$(git-commit)",
        "category": "GitSpecs"
      },
      {
        "command": "gitspecs.blame.toggleFile",
        "title": "GitSpecs: Toggle File Blame",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitspecs.blame.showLine",
        "title": "GitSpecs: Show Line Blame"
      },
      {
        "command": "gitspecs.blame.fileToOutput",
        "title": "GitSpecs: Blame File to Output"
      },
      {
        "command": "gitspecs.blame.statusBarDetails",
        "title": "GitSpecs: Status Bar Blame Details"
      },
      {
        "command": "gitspecs.blame.codeLensDetail",
        "title": "GitSpecs: CodeLens Blame Details"
      },
      {
        "command": "gitspecs.history.file",
        "title": "GitSpecs: File History",
        "icon": "$(history)"
      },
      {
        "command": "gitspecs.history.line",
        "title": "GitSpecs: Line History",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitspecs.compare",
        "title": "GitSpecs: Compare References…",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitspecs.search.commits",
        "title": "GitSpecs: Search Commits…",
        "icon": "$(search)"
      },
      {
        "command": "gitspecs.worktrees.refresh",
        "title": "GitSpecs: Refresh Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.worktrees.create",
        "title": "GitSpecs: Create Worktree…",
        "icon": "$(add)"
      },
      {
        "command": "gitspecs.worktrees.openCurrentWindow",
        "title": "GitSpecs: Open Worktree in Current Window"
      },
      {
        "command": "gitspecs.worktrees.openNewWindow",
        "title": "GitSpecs: Open Worktree in New Window"
      },
      {
        "command": "gitspecs.worktrees.reveal",
        "title": "GitSpecs: Reveal Worktree in File Explorer"
      },
      {
        "command": "gitspecs.worktrees.copyPath",
        "title": "GitSpecs: Copy Worktree Path"
      },
      {
        "command": "gitspecs.worktrees.remove",
        "title": "GitSpecs: Remove Worktree…"
      },
      {
        "command": "gitspecs.worktrees.prune",
        "title": "GitSpecs: Prune Worktrees"
      },
      {
        "command": "gitspecs.branches.refresh",
        "title": "GitSpecs: Refresh Branches",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.branches.create",
        "title": "GitSpecs: Create Branch…",
        "icon": "$(add)"
      },
      {
        "command": "gitspecs.branches.rename",
        "title": "GitSpecs: Rename Branch…"
      },
      {
        "command": "gitspecs.branches.delete",
        "title": "GitSpecs: Delete Branch…"
      },
      {
        "command": "gitspecs.branches.deleteForce",
        "title": "GitSpecs: Delete Branch (Force)…"
      },
      {
        "command": "gitspecs.branches.checkout",
        "title": "GitSpecs: Checkout Branch"
      },
      {
        "command": "gitspecs.branches.publish",
        "title": "GitSpecs: Publish Branch…"
      },
      {
        "command": "gitspecs.branches.push",
        "title": "GitSpecs: Push"
      },
      {
        "command": "gitspecs.branches.pull",
        "title": "GitSpecs: Pull"
      },
      {
        "command": "gitspecs.branches.fetch",
        "title": "GitSpecs: Fetch"
      },
      {
        "command": "gitspecs.branches.setUpstream",
        "title": "GitSpecs: Set Upstream…"
      },
      {
        "command": "gitspecs.branches.deleteRemote",
        "title": "GitSpecs: Delete Remote Branch…"
      },
      {
        "command": "gitspecs.branches.merge",
        "title": "GitSpecs: Merge into Current…"
      },
      {
        "command": "gitspecs.branches.rebase",
        "title": "GitSpecs: Rebase Current Onto…"
      },
      {
        "command": "gitspecs.branches.cherryPick",
        "title": "GitSpecs: Cherry-pick…"
      },
      {
        "command": "gitspecs.branches.createFromCommit",
        "title": "GitSpecs: Create Branch from Commit…"
      },
      {
        "command": "gitspecs.branches.compare",
        "title": "GitSpecs: Compare with…",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitspecs.branches.copyName",
        "title": "GitSpecs: Copy Branch Name"
      },
      {
        "command": "gitspecs.branches.openRemote",
        "title": "GitSpecs: Open on Remote"
      },
      {
        "command": "gitspecs.commits.refresh",
        "title": "GitSpecs: Refresh Commits",
        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.commits.copySha",
        "title": "GitSpecs: Copy Commit SHA"
      },
      {
        "command": "gitspecs.commits.checkout",
        "title": "GitSpecs: Checkout Commit (Detached)"
      },
      {
        "command": "gitspecs.commits.createBranch",
        "title": "GitSpecs: Create Branch from Commit…"
      },
      {
        "command": "gitspecs.commits.openRemote",
        "title": "GitSpecs: Open Commit on Remote"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitspecs.scm.showWorktrees",
          "when": "view == gitspecs.scm",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.scm.showBranches",
          "when": "view == gitspecs.scm",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.scm.showCommits",
          "when": "view == gitspecs.scm",
          "group": "navigation@3"
        },
        {
          "command": "gitspecs.worktrees.create",
          "when": "view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.worktrees.refresh",
          "when": "view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)",
          "group": "navigation@5"
        },
        {
          "command": "gitspecs.branches.create",
          "when": "view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.branches.refresh",
          "when": "view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)",
          "group": "navigation@5"
        },
        {
          "command": "gitspecs.commits.refresh",
          "when": "view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "gitspecs.worktrees.openCurrentWindow",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitspecs.worktrees.openNewWindow",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitspecs.worktrees.reveal",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitspecs.worktrees.copyPath",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitspecs.worktrees.remove",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "3_danger"
        },
        {
          "command": "gitspecs.branches.checkout",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "1_nav"
        },
        {
          "command": "gitspecs.branches.copyName",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.branches.openRemote",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.branches.rename",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "3_mod"
        },
        {
          "command": "gitspecs.branches.delete",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.deleteForce",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.deleteRemote",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchRemote",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.merge",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.branches.rebase",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.branches.compare",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.commits.copySha",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "1_copy"
        },
        {
          "command": "gitspecs.commits.checkout",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.commits.createBranch",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.commits.openRemote",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "3_remote"
        }
      ],
      "commandPalette": [
        {
          "command": "gitspecs.scm.showWorktrees",
          "when": "false"
        },
        {
          "command": "gitspecs.scm.showBranches",
          "when": "false"
        },
        {
          "command": "gitspecs.scm.showCommits",
          "when": "false"
        },
        {
          "command": "gitspecs.worktrees.openCurrentWindow",
          "when": "false"
        },
        {
          "command": "gitspecs.worktrees.openNewWindow",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gitspecs.blame.showLine",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@1"
        },
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@2"
        },
        {
          "command": "gitspecs.history.file",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@3"
        },
        {
          "command": "gitspecs.history.line",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@4"
        }
      ],
      "editor/title": [
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "gitspecs.history.file",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GitSpecs",
      "properties": {
        "gitspecs.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses PATH."
        },
        "gitspecs.worktrees.defaultLocation": {
          "type": "string",
          "default": "",
          "description": "Base directory for new worktrees. Empty = parent of the repository root."
        },
        "gitspecs.worktrees.pathTemplate": {
          "type": "string",
          "default": "${repoName}-${branch}",
          "description": "Leaf folder name template for new worktrees."
        },
        "gitspecs.worktrees.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Default to opening a newly created worktree in a new window."
        },
        "gitspecs.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before deleting worktrees or branches."
        },
        "gitspecs.log.verbosity": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Output channel verbosity."
        },
        "gitspecs.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show current-line blame in the status bar (author • date • short SHA). Click for detail actions."
        },
        "gitspecs.blame.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show file-level blame CodeLens (author count and last change). Click for blame detail."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "pnpm run build && vsce package --no-dependencies -o gitspecs.vsix",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@gitspecs/git-core": "workspace:*",
    "@gitspecs/host-urls": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
