      ],
      "editor/context": [
        {
          "command": "gitspecs.blame.showLine",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@1"
        },
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@2"
        },
        {
          "command": "gitspecs.history.file",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@3"
        },
        {
          "command": "gitspecs.history.line",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@4"
        },
        {
          "command": "gitspecs.revision.openAtRevision",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@5"
        },
        {
          "command": "gitspecs.revision.diffWithPrevious",
          "when": "editorTextFocus && (resourceScheme == file || resourceScheme == gitspecs)",
          "group": "gitspecs@6"
        },
        {
          "command": "gitspecs.revision.diffWithWorking",
          "when": "editorTextFocus && (resourceScheme == file || resourceScheme == gitspecs)",
          "group": "gitspecs@7"
        }
      ],
      "editor/title": [
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "gitspecs.history.file",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "gitspecs.revision.previous",
          "when": "resourceScheme == gitspecs && gitspecs.revision.hasPrevious",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.revision.next",
          "when": "resourceScheme == gitspecs && gitspecs.revision.hasNext",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.revision.diffWithPrevious",
          "when": "resourceScheme == gitspecs || resourceScheme == file",
          "group": "navigation@3"
        },
        {
          "command": "gitspecs.revision.diffWithWorking",
          "when": "resourceScheme == gitspecs",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "GitSpecs",
      "properties": {
        "gitspecs.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses PATH."
        },
        "gitspecs.worktrees.defaultLocation": {
          "type": "string",
          "default": "",
          "description": "Base directory for new worktrees. Empty = parent of the repository root."
        },
        "gitspecs.worktrees.pathTemplate": {
          "type": "string",
          "default": "${repoName}-${branch}",
          "description": "Leaf folder name template for new worktrees."
        },
        "gitspecs.worktrees.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Default to opening a newly created worktree in a new window."
        },
        "gitspecs.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before deleting worktrees or branches."
        },
        "gitspecs.log.verbosity": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Output channel verbosity."
        },
        "gitspecs.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show current-line blame in the status bar (author • date • short SHA). Click for detail actions."
        },
        "gitspecs.blame.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show file-level blame CodeLens (author count and last change). Click for blame detail."
        },
        "gitspecs.blame.heatmap": {
          "type": "boolean",
          "default": false,
          "description": "When file blame is on, color the overview ruler by author age (newer = warmer). Polish heatmap; off by default."
        },
        "gitspecs.annotations.changes": {
          "type": "boolean",
          "default": false,
          "description": "Highlight lines changed in the working tree and/or unpushed commits. Toggle via GitSpecs: Toggle Changes Annotations."
        },
        "gitspecs.terminalLinks": {
          "type": "boolean",
          "default": true,
          "description": "Detect commit SHAs and branch/tag names in the integrated terminal and offer copy/checkout actions."
        },
        "gitspecs.autolinks": {
          "type": "array",
          "default": [],
          "description": "Issue/PR autolink rules. Each item: { \"prefix\": \"#\", \"url\": \"https://host/issues/<num>\" }. Linkified in blame hovers, history details, and graph tooltips (no network).",
          "items": {
            "type": "object",
            "required": [
              "prefix",
              "url"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "description": "Text before the issue number, e.g. # or JIRA-."
              },
              "url": {
                "type": "string",
                "description": "URL template; <num> is replaced with the captured digits."
              }
            }
          }
        },
        "gitspecs.hosting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hosting integrations (PRs/issues). Inert until signed in; never blocks offline git."
        },
        "gitspecs.hosting.github.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional GitHub API base URL for self-hosted (e.g. https://github.example.com/api/v3)."
        },
        "gitspecs.hosting.gitlab.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional GitLab API base URL for self-hosted (e.g. https://gitlab.example.com/api/v4)."
        },
        "gitspecs.ai.endpoint": {
          "type": "string",
          "default": "",
          "description": "AI API base URL. OpenAI-compatible (e.g. https://api.openai.com/v1) or Anthropic (https://api.anthropic.com). Empty until Configure AI is used."
        },
        "gitspecs.ai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id for BYO-key AI assist (off until configured)."
        },
        "gitspecs.ai.provider": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "anthropic"
          ],
          "default": "openai-compatible",
          "description": "AI provider protocol. Anthropic uses the native Messages API; others use OpenAI-compatible chat completions."
        },
        "gitspecs.currentLine.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show current-line end-of-line blame annotation (independent of full-file blame)."
        },
        "gitspecs.hovers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitSpecs blame hovers."
        },
        "gitspecs.hovers.currentLine.details": {
          "type": "boolean",
          "default": true,
          "description": "Show commit details in current-line blame hover."
        },
        "gitspecs.hovers.currentLine.changes": {
          "type": "boolean",
          "default": true,
          "description": "Show changes section in current-line blame hover."
        },
        "gitspecs.hovers.annotations.details": {
          "type": "boolean",
          "default": true,
          "description": "Show commit details in file-blame annotation hovers."
        },
        "gitspecs.hovers.annotations.changes": {
          "type": "boolean",
          "default": true,
          "description": "Show changes section in file-blame annotation hovers."
        },
        "gitspecs.mode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "zen",
            "review",
            "inspect"
          ],
          "enumDescriptions": [
            "Normal",
            "Zen (quiet chrome)",
            "Review (changes + heatmap)",
            "Inspect (history-focused)"
          ],
          "description": "Active GitSpecs mode profile (Zen / Review / Inspect). Empty = normal."
        },
        "gitspecs.mode.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show active mode in the status bar when a mode is selected."
        }
      }
    },
    "keybindings": [
      {
        "command": "gitspecs.blame.toggleFile",
        "key": "alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitspecs.blame.toggleCodeLens",
        "key": "shift+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitspecs.annotations.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !textInputFocus && !suggestWidgetVisible && !findWidgetVisible"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
