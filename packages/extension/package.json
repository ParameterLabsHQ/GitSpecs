          "when": "view == gitspecs.graph",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.graph.openView",
          "when": "view == gitspecs.graph",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.hub.refresh",
          "when": "view == gitspecs.hub",
          "group": "navigation@1"
        },
        {
