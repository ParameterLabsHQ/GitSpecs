        "icon": "$(refresh)"
      },
      {
        "command": "gitspecs.branches.create",
        "title": "GitSpecs: Create Branch\u2026",
        "icon": "$(add)"
      },
      {
        "command": "gitspecs.branches.rename",
        "title": "GitSpecs: Rename Branch\u2026"
      },
      {
        "command": "gitspecs.branches.delete",
        "title": "GitSpecs: Delete Branch\u2026"
      },
      {
        "command": "gitspecs.branches.deleteForce",
        "title": "GitSpecs: Delete Branch (Force)\u2026"
      },
      {
        "command": "gitspecs.branches.checkout",
        "title": "GitSpecs: Checkout Branch"
      },
      {
        "command": "gitspecs.branches.publish",
        "title": "GitSpecs: Publish Branch\u2026"
      },
      {
        "command": "gitspecs.branches.push",
        "title": "GitSpecs: Push"
      },
      {
        "command": "gitspecs.branches.pull",
        "title": "GitSpecs: Pull"
      },
      {
        "command": "gitspecs.branches.fetch",
        "title": "GitSpecs: Fetch"
      },
      {
        "command": "gitspecs.branches.setUpstream",
        "title": "GitSpecs: Set Upstream\u2026"
      },
      {
        "command": "gitspecs.branches.deleteRemote",
