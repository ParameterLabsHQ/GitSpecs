{
  "name": "gitspecs",
  "displayName": "GitSpecs",
  "description": "Open-source GitLens-style worktrees, branches, commits, stashes, tags, remotes, blame, history, compare, and search for VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "ParameterLabsHQ",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParameterLabsHQ/GitSpecs.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:gitspecs.worktrees",
    "onView:gitspecs.branches",
    "onView:gitspecs.commits",
    "onView:gitspecs.scm",
    "onCommand:gitspecs.switchRepository",
    "onCommand:gitspecs.scm.showWorktrees",
    "onCommand:gitspecs.scm.showBranches",
    "onCommand:gitspecs.scm.showCommits",
    "onCommand:gitspecs.worktrees.refresh",
    "onCommand:gitspecs.branches.refresh",
    "onCommand:gitspecs.commits.refresh",
    "onCommand:gitspecs.blame.toggleFile",
    "onCommand:gitspecs.blame.showLine",
    "onCommand:gitspecs.blame.fileToOutput",
    "onCommand:gitspecs.blame.statusBarDetails",
    "onCommand:gitspecs.blame.codeLensDetail",
    "onCommand:gitspecs.history.file",
    "onCommand:gitspecs.history.line",
    "onCommand:gitspecs.history.visualFile",
    "onCommand:gitspecs.revision.openAtRevision",
    "onCommand:gitspecs.revision.diffWithPrevious",
    "onCommand:gitspecs.revision.diffWithWorking",
    "onCommand:gitspecs.revision.previous",
    "onCommand:gitspecs.revision.next",
    "onCommand:gitspecs.annotations.toggleChanges",
    "onCommand:gitspecs.compare",
    "onCommand:gitspecs.compare.dualPane",
    "onCommand:gitspecs.search.commits",
    "onView:gitspecs.stashes",
    "onCommand:gitspecs.scm.showStashes",
    "onCommand:gitspecs.stashes.refresh",
    "onCommand:gitspecs.stashes.push",
    "onView:gitspecs.tags",
    "onView:gitspecs.remotes",
    "onCommand:gitspecs.tags.refresh",
    "onCommand:gitspecs.tags.create",
    "onCommand:gitspecs.remotes.refresh",
    "onCommand:gitspecs.remotes.fetch",
    "onView:gitspecs.contributors",
    "onCommand:gitspecs.contributors.refresh",
    "onView:gitspecs.graph",
    "onCommand:gitspecs.graph.refresh",
    "onCommand:gitspecs.graph.openView",
    "onCommand:gitspecs.rewrite.rebase",
    "onCommand:gitspecs.rewrite.cherryPick",
    "onCommand:gitspecs.rewrite.abort",
    "onCommand:gitspecs.rewrite.continue",
    "onCommand:gitspecs.rewrite.status",
    "onCommand:gitspecs.rewrite.interactiveRebase",
    "onCommand:gitspecs.rewrite.editTodo",
    "onView:gitspecs.hub",
    "onCommand:gitspecs.hosting.signInGitHub",
    "onCommand:gitspecs.hosting.signOutGitHub",
    "onCommand:gitspecs.hosting.prForBranch",
    "onCommand:gitspecs.hosting.createPr",
    "onCommand:gitspecs.hosting.setGitLabPat",
    "onCommand:gitspecs.hosting.setBitbucketPat",
    "onCommand:gitspecs.hosting.setAzurePat",
    "onCommand:gitspecs.hosting.signOutPats",
