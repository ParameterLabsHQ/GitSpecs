      {
        "command": "gitspecs.rewrite.status",
        "title": "GitSpecs: Rewrite Status"
      },
      {
        "command": "gitspecs.rewrite.rebase",
        "title": "GitSpecs: Guided Rebase\u2026"
      },
      {
        "command": "gitspecs.rewrite.cherryPick",
        "title": "GitSpecs: Guided Cherry-pick\u2026"
      },
      {
        "command": "gitspecs.rewrite.abort",
        "title": "GitSpecs: Abort Rewrite"
      },
      {
        "command": "gitspecs.rewrite.continue",
        "title": "GitSpecs: Continue Rewrite"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitspecs.scm.showWorktrees",
          "when": "view == gitspecs.scm",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.scm.showBranches",
          "when": "view == gitspecs.scm",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.scm.showCommits",
          "when": "view == gitspecs.scm",
          "group": "navigation@3"
        },
        {
          "command": "gitspecs.worktrees.create",
          "when": "view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.worktrees.refresh",
          "when": "view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)",
          "group": "navigation@5"
        },
        {
          "command": "gitspecs.branches.create",
          "when": "view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.branches.refresh",
          "when": "view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)",
          "group": "navigation@5"
        },
        {
          "command": "gitspecs.commits.refresh",
          "when": "view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.scm.showStashes",
          "when": "view == gitspecs.scm",
          "group": "navigation@4"
        },
        {
          "command": "gitspecs.stashes.push",
          "when": "view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)",
          "group": "navigation@5"
        },
        {
          "command": "gitspecs.stashes.refresh",
          "when": "view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)",
          "group": "navigation@6"
        },
        {
          "command": "gitspecs.tags.create",
          "when": "view == gitspecs.tags",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.tags.refresh",
          "when": "view == gitspecs.tags",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.remotes.refresh",
          "when": "view == gitspecs.remotes",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.remotes.fetch",
          "when": "view == gitspecs.remotes",
          "group": "navigation@2"
        },
        {
          "command": "gitspecs.contributors.refresh",
          "when": "view == gitspecs.contributors",
          "group": "navigation@1"
        },
        {
          "command": "gitspecs.graph.refresh",
          "when": "view == gitspecs.graph",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitspecs.worktrees.openCurrentWindow",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitspecs.worktrees.openNewWindow",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "1_open"
        },
        {
          "command": "gitspecs.worktrees.reveal",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitspecs.worktrees.copyPath",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "2_path"
        },
        {
          "command": "gitspecs.worktrees.remove",
          "when": "(view == gitspecs.worktrees || (view == gitspecs.scm && gitspecs.scm.tab == worktrees)) && viewItem == worktree",
          "group": "3_danger"
        },
        {
          "command": "gitspecs.branches.checkout",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "1_nav"
        },
        {
          "command": "gitspecs.branches.copyName",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.branches.openRemote",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.branches.rename",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "3_mod"
        },
        {
          "command": "gitspecs.branches.delete",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.deleteForce",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchLocal",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.deleteRemote",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem == branchRemote",
          "group": "4_danger"
        },
        {
          "command": "gitspecs.branches.merge",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.branches.rebase",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.branches.compare",
          "when": "(view == gitspecs.branches || (view == gitspecs.scm && gitspecs.scm.tab == branches)) && viewItem =~ /branch/",
          "group": "5_hist"
        },
        {
          "command": "gitspecs.commits.copySha",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "1_copy"
        },
        {
          "command": "gitspecs.commits.checkout",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.commits.createBranch",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.commits.openRemote",
          "when": "(view == gitspecs.commits || (view == gitspecs.scm && gitspecs.scm.tab == commits)) && viewItem == commit",
          "group": "3_remote"
        },
        {
          "command": "gitspecs.stashes.apply",
          "when": "(view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)) && viewItem == stash",
          "group": "1_apply"
        },
        {
          "command": "gitspecs.stashes.pop",
          "when": "(view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)) && viewItem == stash",
          "group": "1_apply"
        },
        {
          "command": "gitspecs.stashes.show",
          "when": "(view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)) && viewItem == stash",
          "group": "2_show"
        },
        {
          "command": "gitspecs.stashes.drop",
          "when": "(view == gitspecs.stashes || (view == gitspecs.scm && gitspecs.scm.tab == stashes)) && viewItem == stash",
          "group": "3_danger"
        },
        {
          "command": "gitspecs.tags.checkout",
          "when": "view == gitspecs.tags && viewItem == tag",
          "group": "1_nav"
        },
        {
          "command": "gitspecs.tags.copyName",
          "when": "view == gitspecs.tags && viewItem == tag",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.tags.delete",
          "when": "view == gitspecs.tags && viewItem == tag",
          "group": "3_danger"
        },
        {
          "command": "gitspecs.remotes.fetch",
          "when": "view == gitspecs.remotes && viewItem == remote",
          "group": "1_nav"
        },
        {
          "command": "gitspecs.remotes.copyUrl",
          "when": "view == gitspecs.remotes && viewItem == remote",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.remotes.open",
          "when": "view == gitspecs.remotes && viewItem == remote",
          "group": "2_copy"
        },
        {
          "command": "gitspecs.contributors.copyName",
          "when": "view == gitspecs.contributors && viewItem == contributor",
          "group": "1_copy"
        },
        {
          "command": "gitspecs.contributors.copyEmail",
          "when": "view == gitspecs.contributors && viewItem == contributor",
          "group": "1_copy"
        },
        {
          "command": "gitspecs.graph.copySha",
          "when": "view == gitspecs.graph && viewItem == graphCommit",
          "group": "1_copy"
        },
        {
          "command": "gitspecs.graph.checkout",
          "when": "view == gitspecs.graph && viewItem == graphCommit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.graph.createBranch",
          "when": "view == gitspecs.graph && viewItem == graphCommit",
          "group": "2_nav"
        },
        {
          "command": "gitspecs.graph.compare",
          "when": "view == gitspecs.graph && viewItem == graphCommit",
          "group": "3_hist"
        },
        {
          "command": "gitspecs.graph.openRemote",
          "when": "view == gitspecs.graph && viewItem == graphCommit",
          "group": "3_hist"
        }
      ],
      "commandPalette": [
        {
          "command": "gitspecs.scm.showWorktrees",
          "when": "false"
        },
        {
          "command": "gitspecs.scm.showBranches",
          "when": "false"
        },
        {
          "command": "gitspecs.scm.showCommits",
          "when": "false"
        },
        {
          "command": "gitspecs.worktrees.openCurrentWindow",
          "when": "false"
        },
        {
          "command": "gitspecs.worktrees.openNewWindow",
          "when": "false"
        },
        {
          "command": "gitspecs.scm.showStashes",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gitspecs.blame.showLine",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@1"
        },
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@2"
        },
        {
          "command": "gitspecs.history.file",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@3"
        },
        {
          "command": "gitspecs.history.line",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "gitspecs@4"
        }
      ],
      "editor/title": [
        {
          "command": "gitspecs.blame.toggleFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "gitspecs.history.file",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GitSpecs",
      "properties": {
        "gitspecs.git.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git executable. Empty uses PATH."
        },
        "gitspecs.worktrees.defaultLocation": {
          "type": "string",
          "default": "",
          "description": "Base directory for new worktrees. Empty = parent of the repository root."
        },
        "gitspecs.worktrees.pathTemplate": {
          "type": "string",
          "default": "${repoName}-${branch}",
          "description": "Leaf folder name template for new worktrees."
        },
        "gitspecs.worktrees.openInNewWindow": {
          "type": "boolean",
          "default": true,
          "description": "Default to opening a newly created worktree in a new window."
        },
        "gitspecs.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before deleting worktrees or branches."
        },
        "gitspecs.log.verbosity": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Output channel verbosity."
        },
        "gitspecs.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show current-line blame in the status bar (author \u2022 date \u2022 short SHA). Click for detail actions."
        },
        "gitspecs.blame.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show file-level blame CodeLens (author count and last change). Click for blame detail."
        },
        "gitspecs.blame.heatmap": {
          "type": "boolean",
          "default": false,
          "description": "When file blame is on, color the overview ruler by author age (newer = warmer). Polish heatmap; off by default."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "pnpm run build && vsce package --no-dependencies -o gitspecs.vsix",
    "vscode:prepublish": "pnpm run build"
  },
  "dependencies": {
    "@gitspecs/git-core": "workspace:*",
    "@gitspecs/host-urls": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
